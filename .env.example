# Sentinel — Environment Configuration

# LLM Provider (Venice.ai is default, OpenAI-compatible)
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_API_KEY=your-venice-api-key
LLM_MODEL=llama-3.3-70b

# Uniswap Trading API
UNISWAP_API_KEY=your-uniswap-api-key

# Chain RPC endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Agent wallet (KEEP SECRET — never commit .env)
AGENT_PRIVATE_KEY=0x...

# Risk parameters
MAX_TRADE_SIZE_USD=100
MAX_DAILY_VOLUME_USD=500
MAX_DRAWDOWN_PCT=10
COOLDOWN_SECONDS=60
INITIAL_EQUITY_USD=0          # 0 = auto-detect from on-chain portfolio

# Circuit breaker
MAX_CONSECUTIVE_LOSSES=5      # Trip after N consecutive losses
MAX_EQUITY_DROP_RATE_BPS=1000 # Trip if equity drops >10%/hour
MAX_DATA_STALENESS_SECS=300   # Trip if price data >5min old

# Dashboard & alerting
DASHBOARD_PORT=3000
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ERC-8004 / Synthesis hackathon (optional)
# ERC8004_CONTRACT_ADDRESS=0x...
# SYNTHESIS_API_KEY=sk-synth-...

# Mode: autonomous | interactive | smoke
MODE=interactive

# Logging
LOG_LEVEL=info
